# /etc/onesync/agent.env  (mode 0600). install.sh writes this for you.
CONTROL_PLANE_URL=https://control.example.in
AGENT_TOKEN_FILE=/etc/onesync/agent.token
RELEASE_PUBLIC_KEY_FILE=/etc/onesync/release-public.pem
PLATFORM_ADMIN_TOKEN_FILE=/etc/onesync/platform-admin.token
IMAGE_REGISTRY=registry.example.in/onesync
# Hybrid sites: the gateway the remote-access tunnel dials (outbound HTTPS). Leave out for Local sites.
# GATEWAY_URL=https://gateway.example.in
# Optional (defaults shown):
# STATE_FILE=/var/lib/onesync/agent-state.json
# LOCAL_API_URL=http://127.0.0.1:8080
# BACKUP_COMMAND=/usr/local/bin/onesync-backup
# RESTORE_COMMAND=/usr/local/bin/onesync-restore
# HEARTBEAT_SECONDS=60
# CHECK_SECONDS=300
# SUPPORT_SECONDS=15
