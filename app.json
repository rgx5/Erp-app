{
  "expo": {
    "name": "Kosh ERP",
    "slug": "kosh-erp",
    "scheme": "kosh",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1220",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kosh.erp",
      "infoPlist": {
        "NSCameraUsageDescription": "Kosh uses the camera to scan barcodes on your products.",
        "NSFaceIDUsageDescription": "Kosh uses Face ID to unlock the app and protect your business data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kosh.erp",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Kosh uses the camera to scan barcodes on your products.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Kosh uses Face ID to unlock the app and protect your business data." }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220",
          "dark": { "backgroundColor": "#0B1220" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
