# Runtime (application role: not owner, no BYPASSRLS)
NODE_ENV=development
PORT=8080
HTTP_ADAPTER=fastify
LOG_LEVEL=info
DATABASE_URL=postgresql://erp_app:erp_app_dev_password@localhost:5432/erp
DATABASE_POOL_MAX=20
# Slice 0 only: tenant is taken from the X-Tenant-Id header. Refused in production until the identity slice replaces it.
AUTH_MODE=dev-header
# Enables POST /v1/platform/tenants (>= 32 chars). Leave unset to disable.
PLATFORM_ADMIN_TOKEN=
# Migrations only (table owner)
MIGRATOR_DATABASE_URL=postgresql://erp_migrator:erp_migrator_dev_password@localhost:5432/erp
