# Runtime (application role: not owner, no BYPASSRLS)
NODE_ENV=development
PORT=8080
HTTP_ADAPTER=fastify
LOG_LEVEL=info
DATABASE_URL=postgresql://erp_app:erp_app_dev_password@localhost:5432/erp
DATABASE_POOL_MAX=20
# Signing key for access tokens (Ed25519, PKCS#8 PEM; generate: openssl genpkey -algorithm ed25519). REQUIRED in production;
# in development an ephemeral key is generated at start (tokens stop working at restart).
AUTH_JWT_PRIVATE_KEY=
# JSON array of retired public keys still accepted while tokens signed by them expire (key rotation).
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts MFA seeds. REQUIRED in production.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# Anyone can create a tenant at /v1/auth/signup when true. Default false.
SELF_SIGNUP_ENABLED=false
# Outbox relay (defaults: on, except in NODE_ENV=test).
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=8
IDEMPOTENCY_TTL_SECONDS=86400
# Enables POST /v1/platform/tenants (>= 32 chars). Leave unset to disable.
PLATFORM_ADMIN_TOKEN=
# Migrations only (table owner)
MIGRATOR_DATABASE_URL=postgresql://erp_migrator:erp_migrator_dev_password@localhost:5432/erp
