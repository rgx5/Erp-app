    "/v1/business-locations": {
      "post": {
        "operationId": "OrganizationController_createBusinessLocation",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Slice 0 only: the tenant to act for (replaced by authentication)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "companyId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "gstRegistrationId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "isPrincipalPlace": {
                    "default": false,
                    "type": "boolean"
                  },
                  "addressLine1": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "addressLine2": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "stateCode": {
                    "type": "string",
                    "pattern": "^[0-9]{2}$"
                  },
                  "pincode": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{5}$"
                  }
                },
                "required": [
                  "companyId",
                  "code",
                  "name",
                  "addressLine1",
                  "city",
                  "stateCode",
                  "pincode"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "organization"
        ]
      },
