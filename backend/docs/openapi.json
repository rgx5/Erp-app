    "/v1/companies/{id}/gst-registrations": {
      "post": {
        "operationId": "OrganizationController_createGstRegistration",
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "description": "Slice 0 only: the tenant to act for (replaced by authentication)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "gstin": {
                    "type": "string"
                  },
                  "legalName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "tradeName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "registrationType": {
                    "default": "regular",
                    "type": "string",
                    "enum": [
                      "regular",
                      "composition",
                      "sez_unit",
                      "sez_developer",
                      "casual",
                      "non_resident",
                      "isd",
                      "tds",
                      "tcs",
                      "ecommerce_operator"
                    ]
                  },
                  "effectiveFrom": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "effectiveTo": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "gstin",
                  "legalName",
                  "effectiveFrom"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "organization"
        ]
      },
