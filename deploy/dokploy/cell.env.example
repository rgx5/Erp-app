# Paste into the Dokploy service's Environment tab for one cell (generate with ./gen-secrets.sh; each cell gets its own).
PG_SUPERUSER_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
# Ed25519 private key that signs sign-in tokens (PEM; line breaks may be written as \n). Different for every cell.
AUTH_JWT_PRIVATE_KEY=
# 32 random bytes, base64. Different for every cell.
DATA_ENCRYPTION_KEY=
# At least 32 characters. Used by the fleet agent and by you to create businesses on this cell. The stack never exposes it to the internet.
PLATFORM_ADMIN_TOKEN=
# The control plane's licence PUBLIC key (printed by gen-secrets.sh). Leave empty only while testing.
LICENCE_PUBLIC_KEY=
# The cell's id in the control plane (the "site" id), once you have created it there.
SITE_ID=
CORS_ALLOWED_ORIGINS=app://onesync
API_LOOPBACK_PORT=8081
LOG_LEVEL=info
# Demo servers only: true lets POST /v1/demo/seed fill the cell with sample data. Never true where real businesses live.
DEMO_SEED_ENABLED=false

# Lead management (optional). The secret of the Meta app that sends lead-ad webhooks. Leave empty if each client brings their own app secret.
META_APP_SECRET=

# Continuous backups with point-in-time recovery. Fill all five, with a bucket at a DIFFERENT provider than this server. Empty = daily dumps only.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_PATH=/cell
# A long random phrase that encrypts the backups. Keep a copy in your secret manager: without it the backups cannot be opened.
BACKUP_CIPHER_PASS=

# Per-client limits: requests one client may have running at once on this cell, and of those how many reports/exports. 0 = no limit.
TENANT_MAX_CONCURRENT=60
TENANT_MAX_CONCURRENT_HEAVY=4
