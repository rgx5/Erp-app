# Paste into the Dokploy service's Environment tab (generate real values with ./gen-secrets.sh; never commit real ones).
CP_DB_PASSWORD=
# Ed25519 keys (PEM). Multi-line values may be pasted on one line with the line breaks written as \n.
LICENCE_PRIVATE_KEY=
RELEASE_PRIVATE_KEY=
# 32 random bytes, base64.
DATA_ENCRYPTION_KEY=
# At least 32 characters; the gateway and the control plane share it.
GATEWAY_TOKEN=
# Optional until you start giving clients backup keys (made with the cli's escrow-keygen; the two private shares go to two custodians, offline).
ESCROW_PUBLIC_KEY=
REQUIRE_STAFF_MFA=true
SILENT_AFTER_MINUTES=10
# Optional, no terminal needed: the first admin is created on start-up when there is no staff yet. Remove these two lines after you have signed in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Demo servers only: shows a "Fill with demo data" button on an empty dashboard.
DEMO_SEED_ENABLED=false
