{
  "name": "onesync-desktop-client",
  "version": "0.1.0",
  "private": true,
  "description": "OneSyncERP desktop client (Windows, macOS, Linux) for the OneSyncERP backend.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.mts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "api:gen": "openapi-typescript ../backend/docs/openapi.json -o src/api/schema.d.ts",
    "api:check": "npm run api:gen && git diff --exit-code src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src electron tests",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.mts",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder",
    "test:e2e:desktop": "E2E_ELECTRON=1 playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jsbarcode": "^3.12.3"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.74.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "author": "OneSyncERP",
  "homepage": "https://onesync.example",
  "build": {
    "appId": "com.onesync.erp.client",
    "productName": "OneSyncERP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "OneSyncERP"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rgx5/Erp-app.git"
  }
}
