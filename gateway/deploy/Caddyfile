# TLS for every client address. A wildcard certificate for *.remote.example.in (DNS challenge) is the simplest; list each address otherwise.
# The gateway itself speaks plain HTTP on 127.0.0.1:8443; it carries both remote users' requests and the sites' tunnels (WebSocket on /tunnel).
*.remote.example.in, gateway.example.in {
	tls { dns <your-dns-provider> {env.DNS_API_TOKEN} }
	reverse_proxy 127.0.0.1:8443 {
		flush_interval -1      # stream replies as they come (exports, large lists)
	}
}
